# Copy to .env and fill in the values. .env is git-ignored: never commit real values.

# OpenRouter: the only LLM path (brief §2).
OPENROUTER_API_KEY=

# Model IDs. Verify them on OpenRouter before use (G0-RT-01); nothing is hard-coded.
MODEL_CHEAP=
MODEL_STRONG=

# Slack app "coLEX" (Socket Mode): bot token and app-level token.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
